# R2 CDN — local staging area for images before upload. Never committed.
# New images: drop in static/images-source/<year>/<month>/..., run
# scripts/upload-image.sh (or the upload-images.yml GH Action picks them up),
# then reference by R2 URL in the post (https://pub-XXX.r2.dev/<year>/<month>/...).
static/images-source/
.env.r2

